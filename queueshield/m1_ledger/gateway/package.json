{
  "name": "queueshield-ledger-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "M1 ledger gateway: REST + SSE over the queueshield chaincode (live Drunix) or an in-memory mock",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node src/main.ts",
    "start:mock": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "typescript": "5.7.3"
  }
}
