{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queueshield.local/schemas/recommendation.schema.json",
  "title": "Recommendation package (M4 -> M5)",
  "type": "object",
  "required": [
    "rec_id",
    "incident_id",
    "run_id",
    "created_sim_ms",
    "segment_id",
    "severity",
    "verdict",
    "confidence",
    "actions",
    "reasons",
    "status",
    "model_versions",
    "features_sha256"
  ],
  "properties": {
    "rec_id": {
      "type": "string",
      "pattern": "^rec-[0-9]{4}$"
    },
    "incident_id": {
      "type": "string"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/RunId"
    },
    "created_sim_ms": {
      "$ref": "common.schema.json#/$defs/SimMs"
    },
    "segment_id": {
      "$ref": "common.schema.json#/$defs/SegmentId"
    },
    "severity": {
      "enum": [
        "WARNING",
        "CRITICAL"
      ]
    },
    "verdict": {
      "enum": [
        "PSP_SIDE",
        "BANK_SIDE",
        "ROUTE_SPECIFIC",
        "SWITCH_STATUS_OVERLOAD",
        "MULTI_FAULT",
        "PLATFORM_WIDE",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "p_stuck": {
      "type": [
        "number",
        "null"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "countdown_s_estimate": {
      "type": [
        "number",
        "null"
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_type",
          "params",
          "scope_segment_id",
          "eligible",
          "side_effect",
          "rollback_condition"
        ],
        "properties": {
          "action_type": {
            "enum": [
              "THROTTLE_RETRIES",
              "SHED_EXPIRED",
              "PRIORITIZE_FRESH",
              "SHIFT_TRAFFIC",
              "CHECK_BUDGET",
              "DEFER_CHECKS",
              "PACE_PAYOUTS",
              "HOLD_MONITOR",
              "ESCALATE_HUMAN",
              "ROLLBACK"
            ]
          },
          "params": {
            "type": "object"
          },
          "scope_segment_id": {
            "$ref": "common.schema.json#/$defs/SegmentId"
          },
          "eligible": {
            "type": "boolean"
          },
          "blocked_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "advisory_kind": {
            "enum": [
              "SLOW_RETRIES",
              "DEFER_CHECKS",
              "DO_NOT_SHIFT",
              "PACE_PAYOUTS",
              null
            ]
          },
          "side_effect": {
            "type": "string"
          },
          "rollback_condition": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Reason"
      }
    },
    "status": {
      "enum": [
        "PENDING",
        "APPROVED",
        "PARTIAL",
        "REJECTED",
        "EXPIRED",
        "SUPERSEDED"
      ]
    },
    "model_versions": {
      "$ref": "common.schema.json#/$defs/ModelVersions"
    },
    "features_sha256": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
