{
  "name": "queueshield-console",
  "version": "0.1.0",
  "private": true,
  "description": "M5 operator console: see, approve and replay (simulation data only)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8000",
    "gen:types": "node scripts/gen-types.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
