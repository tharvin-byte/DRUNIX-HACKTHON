{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queueshield.local/schemas/incident.schema.json",
  "title": "Incident (M3 -> M4, M5)",
  "type": "object",
  "required": [
    "incident_id",
    "run_id",
    "segment_id",
    "state",
    "severity",
    "opened_sim_ms",
    "updated_sim_ms",
    "verdict",
    "reasons",
    "confidence",
    "model_versions",
    "features_sha256"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^inc-[0-9]{4}$"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/RunId"
    },
    "segment_id": {
      "$ref": "common.schema.json#/$defs/SegmentId"
    },
    "state": {
      "enum": [
        "OPEN",
        "MITIGATING",
        "RECOVERING",
        "CLOSED"
      ]
    },
    "severity": {
      "enum": [
        "WARNING",
        "CRITICAL"
      ]
    },
    "opened_sim_ms": {
      "$ref": "common.schema.json#/$defs/SimMs"
    },
    "updated_sim_ms": {
      "$ref": "common.schema.json#/$defs/SimMs"
    },
    "closed_sim_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "PSP_SIDE",
        "BANK_SIDE",
        "ROUTE_SPECIFIC",
        "SWITCH_STATUS_OVERLOAD",
        "MULTI_FAULT",
        "PLATFORM_WIDE",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "p_stuck": {
      "type": [
        "number",
        "null"
      ]
    },
    "countdown_s_estimate": {
      "type": [
        "number",
        "null"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Reason"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "model_versions": {
      "$ref": "common.schema.json#/$defs/ModelVersions"
    },
    "features_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
