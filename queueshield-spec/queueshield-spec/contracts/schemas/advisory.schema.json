{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queueshield.local/schemas/advisory.schema.json",
  "title": "Advisory (M4 -> M1; read by M2 and M5)",
  "type": "object",
  "required": [
    "id",
    "kind",
    "segmentId",
    "params",
    "reason",
    "evidenceHash",
    "decisionId",
    "issuedSimMs",
    "validForSec"
  ],
  "properties": {
    "docType": {
      "const": "advisory"
    },
    "id": {
      "type": "string",
      "pattern": "^adv-[0-9]{5}$"
    },
    "kind": {
      "enum": [
        "SLOW_RETRIES",
        "DEFER_CHECKS",
        "DO_NOT_SHIFT",
        "PACE_PAYOUTS"
      ]
    },
    "segmentId": {
      "$ref": "common.schema.json#/$defs/SegmentId"
    },
    "params": {
      "type": "object"
    },
    "reason": {
      "type": "string",
      "maxLength": 200
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decisionId": {
      "type": "string"
    },
    "issuedSimMs": {
      "$ref": "common.schema.json#/$defs/SimMs"
    },
    "validForSec": {
      "type": "integer",
      "minimum": 5,
      "maximum": 3600
    },
    "issuedAt": {
      "type": "integer"
    },
    "expiresAt": {
      "type": "integer"
    },
    "revoked": {
      "type": "boolean"
    },
    "revokedReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "issuerMspId": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
